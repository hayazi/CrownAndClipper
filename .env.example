# GEMINI_API_KEY: Required if Gemini features are enabled.
GEMINI_API_KEY=

# APP_URL: The public URL where this service is hosted (injected by AI Studio / Cloud Run).
APP_URL=

# BOOKING_MODE: "mock" for local/preview demo without live Google credentials, "live" for production Google Calendar.
BOOKING_MODE=mock

# TZ: Scheduling timezone (must remain Australia/Sydney).
TZ=Australia/Sydney

# GOOGLE_CALENDAR_ID: Target Google Calendar ID (e.g., "primary" or barber's calendar email).
GOOGLE_CALENDAR_ID=primary

# Option A (Recommended for Cloud Run): Single-line JSON of a Google Cloud Service Account
# that has "Make changes to events" permission on GOOGLE_CALENDAR_ID.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B (Alternative for Cloud Run): Server-side OAuth2 refresh token for the barber's Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ALLOWED_ORIGIN: Optional comma-separated origin allowlist for production CORS checks.
ALLOWED_ORIGIN=

# ADMIN_USERNAME & ADMIN_PASSWORD: Credentials for the Studio Admin panel (create/update services).
# Set these in Settings -> Secrets or Cloud Run Secret Manager before sharing or deploying.
ADMIN_USERNAME=
ADMIN_PASSWORD=

